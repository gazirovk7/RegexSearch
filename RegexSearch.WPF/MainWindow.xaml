<Window x:Class="RegexSearch.WPF.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Поиск номеров полиса ОМС — вариант 8"
 Height="690" Width="1120" MinHeight="560" MinWidth="900"
 WindowStartupLocation="CenterScreen" Background="#F3F6FA">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,14">
   <TextBlock Text="Поиск номеров полиса ОМС" FontSize="26" FontWeight="Bold" Foreground="#172B4D"/>
   <TextBlock Text="Вариант 8 • 16 цифр • сравнение регулярного выражения и конечного автомата"
    FontSize="13" Foreground="#63738A" Margin="0,4,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12"
   BorderBrush="#DCE3EC" BorderThickness="1">
   <StackPanel>
    <TextBlock Text="Шаблон распознавания" FontWeight="SemiBold" Foreground="#34445A"/>
    <TextBlock x:Name="PatternText" FontFamily="Consolas" FontSize="14"
     Foreground="#1765A5" TextWrapping="Wrap" Margin="0,5,0,0"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <WrapPanel Grid.Row="0" Margin="0,0,0,12">
    <Button Content="Поиск через Regex" Click="RegexButton_Click" Padding="14,8" Margin="0,0,8,0"
     Background="#2878C8" Foreground="White" BorderThickness="0"/>
    <Button Content="Поиск через автомат" Click="AutomatonButton_Click" Padding="14,8" Margin="0,0,8,0"
     Background="#21875A" Foreground="White" BorderThickness="0"/>
    <Button Content="Сравнить алгоритмы" Click="CompareButton_Click" Padding="14,8" Margin="0,0,8,0"
     Background="#6B62B5" Foreground="White" BorderThickness="0"/>
    <Button Content="Очистить" Click="ClearButton_Click" Padding="14,8"
     Background="#E2E8F0" Foreground="#34445A" BorderThickness="0"/>
   </WrapPanel>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <GroupBox Header="Исходный текст" Grid.Column="0" Background="White" Padding="8">
     <TextBox x:Name="InputText" AcceptsReturn="True" AcceptsTab="True"
      TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
      FontFamily="Consolas" FontSize="14" Padding="8" VerticalContentAlignment="Top"/>
    </GroupBox>
    <GroupBox Header="Результаты поиска" Grid.Column="2" Background="White" Padding="8">
     <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
      RowHeaderWidth="0" FontSize="13">
      <DataGrid.Columns>
       <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="40"/>
       <DataGridTextColumn Header="Совпадение" Binding="{Binding Value}" Width="*"/>
       <DataGridTextColumn Header="Позиция" Binding="{Binding Position}" Width="70"/>
       <DataGridTextColumn Header="Длина" Binding="{Binding Length}" Width="55"/>
      </DataGrid.Columns>
     </DataGrid>
    </GroupBox>
   </Grid>
  </Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#DCE3EC" BorderThickness="1"
   CornerRadius="7" Padding="10" Margin="0,12,0,0">
   <DockPanel>
    <TextBlock x:Name="SummaryText" Text="Введите текст и выберите режим поиска."
     Foreground="#34445A" VerticalAlignment="Center"/>
    <TextBlock x:Name="StatusText" Text="Готово" Foreground="#21875A"
     DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
